  "description": "EFA RDMA traffic for EKS GPU nodes. p5.48xlarge has 32 EFA NICs (rdmap*) per node \u2014 not the previous AKS layout of 8\u00d7 ConnectX-7 (mlx5_*).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 101,
      "title": "Per-Node TX vs RX (Node A / Node B)",
      "type": "row"
    },
    {
      "title": "TX vs RX \u2014 $node_repeat_1",
      "description": "TX (positive/up) vs RX (negative/down) per EFA device. Node A/B default to the first and second instances (alphabetical); change the dropdowns to compare any pair.",
      "type": "timeseries",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": true,
            "axisLabel": "RX \u2193  /  \u2191 TX",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 40,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(node_amazonefa_tx_bytes{instance=~\"$node_repeat_1\", device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "TX {{device}}",
          "refId": "TX"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "-rate(node_amazonefa_rx_bytes{instance=~\"$node_repeat_1\", device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "RX {{device}}",
          "refId": "RX"
        }
      ]
    },
